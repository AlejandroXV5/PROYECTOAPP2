<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GAME"
             xmlns:converters="clr-namespace:GAME.Converters"
             x:Class="GAME.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:HealthConverter x:Key="HealthConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <!-- Dark Fantasy Menu Button -->
            <Style x:Key="MenuButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#20C9A84C" />
                <Setter Property="TextColor" Value="{StaticResource GoldLight}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20,14" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
            </Style>

            <!-- Gold Border Card Frame -->
            <Style x:Key="DarkCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="15" />
                <Setter Property="HasShadow" Value="False" />
            </Style>

            <!-- Section Title Style -->
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <!-- Section Header Style -->
            <Style x:Key="SectionHeader" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <!-- Body text on dark bg -->
            <Style x:Key="DarkBodyText" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource GoldLight}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Action Button base -->
            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="BorderWidth" Value="0" />
            </Style>

            <!-- Gold Border Button -->
            <Style x:Key="GoldBorderButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="TextColor" Value="{StaticResource Gold}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="15,12" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>