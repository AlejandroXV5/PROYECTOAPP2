<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAME.Views.RulesPage"
             Title="Game Rules">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Game Rules" Style="{StaticResource PageTitle}"/>

            <BoxView HeightRequest="1" Color="{StaticResource GoldDark}" Margin="20,0" />

            <!-- General -->
            <Frame Style="{StaticResource DarkCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="General" Style="{StaticResource SectionHeader}"/>
                    <Label Text="- The game is for two players, pass-and-play." />
                    <Label Text="- Each player chooses a race and a weapon/ability." />
                    <Label Text="- The winner is the player who reduces their opponent's health to 0." />
                </VerticalStackLayout>
            </Frame>

            <!-- Races -->
            <Frame Style="{StaticResource DarkCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Races" Style="{StaticResource SectionHeader}"/>

                    <Label Text="Humans (100 HP)" FontAttributes="Bold" TextColor="{StaticResource Gold}" Margin="0,6,0,0"/>
                    <Label Text="- Can use Shotgun, Sniper Rifle, or Crossbow." />
                    <Label Text="- 'Eat' action recovers 40-50% of missing HP." />

                    <Label Text="Elves (115 HP with Water Staff)" FontAttributes="Bold" TextColor="{StaticResource Gold}" Margin="0,6,0,0"/>
                    <Label Text="- Use magic staffs: Fire, Earth, Air, Water, or Lightning." />
                    <Label Text="- Water Elves have more HP and better healing." />

                    <Label Text="Orcs (100 HP)" FontAttributes="Bold" TextColor="{StaticResource Gold}" Margin="0,6,0,0"/>
                    <Label Text="- Use Axe (causes bleeding), Hammer, or Mace." />
                    <Label Text="- 'Potion' action heals over two turns." />

                    <Label Text="Beasts (100 HP)" FontAttributes="Bold" TextColor="{StaticResource Gold}" Margin="0,6,0,0"/>
                    <Label Text="- Use Fists (high damage), Sword, or Claws." />
                    <Label Text="- Claws deal high damage but cannot heal." />
                    <Label Text="- 'Sleep' action recovers 50% of lost HP." />
                </VerticalStackLayout>
            </Frame>

            <!-- Combat -->
            <Frame Style="{StaticResource DarkCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Combat" Style="{StaticResource SectionHeader}"/>
                    <Label Text="- The game is turn-based." />
                    <Label Text="- You can Move Forward, Move Backward, Attack, or Heal on your turn." />
                    <Label Text="- Some attacks are only effective at certain distances." />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>