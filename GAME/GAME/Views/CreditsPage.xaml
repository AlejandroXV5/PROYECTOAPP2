<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GAME.Views.CreditsPage"
             Title="Credits">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center" HorizontalOptions="Center">

        <Label Text="{Binding CreditsTitle}"
               Style="{StaticResource PageTitle}"/>

        <BoxView HeightRequest="1" Color="{StaticResource GoldDark}" Margin="20,0" />

        <Frame Style="{StaticResource DarkCard}" HorizontalOptions="Center" MinimumWidthRequest="300">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="{Binding CreditsDev}"
                       TextColor="{StaticResource GoldLight}"
                       FontSize="16"
                       HorizontalTextAlignment="Center"/>
                <Label Text="{Binding CreditsTech}"
                       TextColor="{StaticResource SteelBlue}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Frame>

        <Label Text="v1.0"
               TextColor="{StaticResource Gray400}"
               FontSize="12"
               HorizontalTextAlignment="Center"/>

    </VerticalStackLayout>
</ContentPage>