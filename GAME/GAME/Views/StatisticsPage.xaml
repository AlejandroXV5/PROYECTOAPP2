<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:GAME.Services"
             x:Class="GAME.Views.StatisticsPage"
             Title="Statistics">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="12">

            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=StatisticsTitle}"
                   Style="{StaticResource PageTitle}"/>

            <!-- Top Players -->
            <Frame Style="{StaticResource DarkCard}" BorderColor="{StaticResource Gold}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=TopPlayersTitle}"
                           Style="{StaticResource SectionHeader}"/>
                    <CollectionView ItemsSource="{Binding TopPlayers}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{StaticResource CardBgLight}" BorderColor="{StaticResource GoldDark}" CornerRadius="8" Padding="10" Margin="0,4" HasShadow="False">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource Gold}"/>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                            <Label Text="{Binding Wins, StringFormat='W: {0}'}" Grid.Column="0" FontSize="12" TextColor="{StaticResource HealthGreen}"/>
                                            <Label Text="{Binding Losses, StringFormat='L: {0}'}" Grid.Column="1" FontSize="12" TextColor="{StaticResource BloodRedBright}"/>
                                            <Label Text="{Binding Draws, StringFormat='D: {0}'}" Grid.Column="2" FontSize="12" TextColor="{StaticResource SteelBlue}"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Recent Matches -->
            <Frame Style="{StaticResource DarkCard}" BorderColor="{StaticResource SteelBlue}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=RecentMatchesTitle}"
                           Style="{StaticResource SectionHeader}"/>
                    <CollectionView ItemsSource="{Binding RecentMatches}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{StaticResource CardBgLight}" BorderColor="{StaticResource GoldDark}" CornerRadius="8" Padding="10" Margin="0,4" HasShadow="False">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Player1Name}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource GoldLight}"/>
                                        <Label Text="{Binding Player2Name, StringFormat='  vs {0}'}" FontSize="13" TextColor="{StaticResource GoldLight}"/>
                                        <Label Text="{Binding WinnerName, StringFormat='Winner: {0}'}" FontSize="12" TextColor="{StaticResource Gold}"/>
                                        <Label Text="{Binding PlayedAt, StringFormat='Date: {0:g}'}" FontSize="10" TextColor="{StaticResource Gray400}"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=ResetStatisticsButtonText}"
                        Command="{Binding ResetStatisticsCommand}"
                        BackgroundColor="{StaticResource BloodRed}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Padding="12"/>

                <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=ReturnToMenuButtonText}"
                        Command="{Binding ReturnToMenuCommand}"
                        Style="{StaticResource GoldBorderButton}"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>