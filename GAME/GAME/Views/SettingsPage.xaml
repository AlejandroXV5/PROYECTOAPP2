<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GAME.ViewModels"
             x:Class="GAME.Views.SettingsPage"
             Title="Settings">
    <ContentPage.BindingContext>
        <viewmodels:SettingsViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="{Binding Localization.SettingsText}"
               Style="{StaticResource PageTitle}"/>

        <BoxView HeightRequest="1" Color="{StaticResource GoldDark}" Margin="20,0" />

        <Label Text="{Binding Localization.LanguageLabel}"
               Style="{StaticResource SectionHeader}"
               HorizontalTextAlignment="Center"/>

        <Frame Style="{StaticResource DarkCard}">
            <VerticalStackLayout Spacing="12">
                <Button Text="{Binding Localization.EnglishText}"
                        Command="{Binding SetEnglishCommand}"
                        Style="{StaticResource GoldBorderButton}" />

                <Button Text="{Binding Localization.SpanishText}"
                        Command="{Binding SetSpanishCommand}"
                        Style="{StaticResource GoldBorderButton}" />
            </VerticalStackLayout>
        </Frame>

    </VerticalStackLayout>
</ContentPage>