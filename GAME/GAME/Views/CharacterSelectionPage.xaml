<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GAME.ViewModels"
             xmlns:services="clr-namespace:GAME.Services"
             x:Class="GAME.Views.CharacterSelectionPage"
             Title="Character Selection">

    <Grid BackgroundColor="Transparent">
        <!-- Background Image -->
        <Image Source="menu_background.jpg" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />

        <!-- Dark Overlay -->
        <BoxView Color="#CC0F0F1A" />

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Player 1 Name Entry -->
                <VerticalStackLayout IsVisible="{Binding IsPlayer1Turn}">
                    <Frame Style="{StaticResource DarkCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=Player1NameLabel}"
                                   Style="{StaticResource SectionHeader}"/>
                            <Entry Placeholder="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=EnterPlayer1NamePlaceholder}"
                                   TextColor="{StaticResource GoldLight}"
                                   Text="{Binding Player1Name}"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Player 2 Name Entry -->
                <VerticalStackLayout IsVisible="{Binding IsPlayer2Turn}">
                    <Frame Style="{StaticResource DarkCard}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=Player2NameLabel}"
                                   Style="{StaticResource SectionHeader}"/>
                            <Entry Placeholder="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=EnterPlayer2NamePlaceholder}"
                                   TextColor="{StaticResource GoldLight}"
                                   Text="{Binding Player2Name}"/>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>

                <!-- Instruction Text -->
                <Label Text="{Binding InstructionText}"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gold}"/>

                <!-- Race Selection -->
                <CollectionView x:Name="RaceList"
                                ItemsSource="{Binding Races}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedRaceInfo, Mode=TwoWay}"
                                HeightRequest="320">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="0" Margin="5" BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource GoldDark}" CornerRadius="12" HasShadow="False">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CharacterSelectionViewModel}}, Path=SelectRaceCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid>
                                    <Image Source="{Binding Image}" Aspect="AspectFill" HeightRequest="150"/>
                                    <Grid BackgroundColor="#AA0F0F1A">
                                        <VerticalStackLayout Padding="10" VerticalOptions="End">
                                            <Label Text="{Binding Name}" TextColor="{StaticResource Gold}" FontSize="18" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" TextColor="{StaticResource GoldLight}" FontSize="11" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Weapon Selection -->
                <Frame Style="{StaticResource DarkCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=SelectWeaponLabel}"
                               Style="{StaticResource SectionHeader}"/>
                        <CollectionView x:Name="WeaponList"
                                        ItemsSource="{Binding AvailableWeapons}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedWeapon, Mode=TwoWay}"
                                        HeightRequest="240">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="8" Margin="5" BackgroundColor="{StaticResource CardBgLight}" BorderColor="{StaticResource GoldDark}" CornerRadius="12" HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CharacterSelectionViewModel}}, Path=SelectWeaponCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Frame.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                            <Image Source="{Binding Image}" HeightRequest="85" Aspect="AspectFill"/>
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource Gold}" HorizontalTextAlignment="Center"/>
                                            <Label Text="{Binding Description}" FontSize="10" LineBreakMode="WordWrap" TextColor="{StaticResource GoldLight}" HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Next / Start Combat Button -->
                <Button Text="{Binding NextButtonText}"
                        Command="{Binding NextCommand}"
                        BackgroundColor="{StaticResource GoldDark}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        Padding="14"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>