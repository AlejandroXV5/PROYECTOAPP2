<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:GAME.Services"
             x:Class="GAME.Views.CombatPage"
             Title="Combat">

    <Grid>
        <!-- Background Image -->
        <Image Source="menu_background.jpg" Aspect="AspectFill" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" />

        <!-- Dark Overlay for Readability -->
        <BoxView Color="#B30F0F1A" />

        <ScrollView>
            <VerticalStackLayout Padding="15" Spacing="10">
                <!-- Turn Indicator -->
                <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource Gold}" CornerRadius="10" Padding="10" HasShadow="False">
                    <Label Text="{Binding TurnIndicatorText}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource Gold}"/>
                </Frame>

                <!-- Player Portraits -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!-- Player 1 Portrait -->
                    <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource SteelBlue}" CornerRadius="12" Padding="8" HasShadow="False" Grid.Column="0">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsPlayer1Turn}" Value="True">
                                <Setter Property="BorderColor" Value="{StaticResource Gold}"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <VerticalStackLayout Spacing="6">
                            <Image Source="{Binding Player1Image}" HeightRequest="110" Aspect="AspectFill"/>
                            <Label Text="{Binding Player1LabelText}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource GoldLight}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Player 2 Portrait -->
                    <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource SteelBlue}" CornerRadius="12" Padding="8" HasShadow="False" Grid.Column="1">
                        <Frame.Triggers>
                            <DataTrigger TargetType="Frame" Binding="{Binding IsPlayer1Turn}" Value="False">
                                <Setter Property="BorderColor" Value="{StaticResource Gold}"/>
                            </DataTrigger>
                        </Frame.Triggers>
                        <VerticalStackLayout Spacing="6">
                            <Image Source="{Binding Player2Image}" HeightRequest="110" Aspect="AspectFill"/>
                            <Label Text="{Binding Player2LabelText}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource GoldLight}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Current Character Image -->
                <Image Source="{Binding CurrentCharacterImage}" HeightRequest="140" />

                <!-- Health Bars -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <!-- Player 1 Health -->
                    <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource HealthGreen}" CornerRadius="10" Padding="10" HasShadow="False" Grid.Column="0">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Player1LabelText}" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource GoldLight}"/>
                            <ProgressBar Progress="{Binding Player1Health, Converter={StaticResource HealthConverter}}"
                                         ProgressColor="{StaticResource HealthGreen}"/>
                            <Label Text="{Binding Player1HPText}"
                                   HorizontalTextAlignment="Center"
                                   FontSize="12"
                                   TextColor="{StaticResource HealthGreen}"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Player 2 Health -->
                    <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource BloodRedBright}" CornerRadius="10" Padding="10" HasShadow="False" Grid.Column="1">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Player2LabelText}" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource GoldLight}"/>
                            <ProgressBar Progress="{Binding Player2Health, Converter={StaticResource HealthConverter}}"
                                         ProgressColor="{StaticResource BloodRedBright}"/>
                            <Label Text="{Binding Player2HPText}"
                                   HorizontalTextAlignment="Center"
                                   FontSize="12"
                                   TextColor="{StaticResource BloodRedBright}"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10">
                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=AttackButtonText}"
                            Command="{Binding AttackCommand}"
                            Grid.Row="0" Grid.Column="0"
                            BackgroundColor="{StaticResource BloodRed}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            IsEnabled="{Binding IsGameOver, Converter={StaticResource InvertedBoolConverter}}"/>
                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=HealButtonText}"
                            Command="{Binding HealCommand}"
                            Grid.Row="0" Grid.Column="1"
                            BackgroundColor="{StaticResource HealthGreen}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            IsEnabled="{Binding IsGameOver, Converter={StaticResource InvertedBoolConverter}}"/>
                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=AdvanceButtonText}"
                            Command="{Binding AdvanceCommand}"
                            Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{StaticResource SteelBlue}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            IsEnabled="{Binding IsGameOver, Converter={StaticResource InvertedBoolConverter}}"/>
                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=RetreatButtonText}"
                            Command="{Binding RetreatCommand}"
                            Grid.Row="1" Grid.Column="1"
                            BackgroundColor="{StaticResource GoldDark}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            IsEnabled="{Binding IsGameOver, Converter={StaticResource InvertedBoolConverter}}"/>
                    <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=SurrenderButtonText}"
                            Command="{Binding SurrenderCommand}"
                            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            BackgroundColor="{StaticResource CardBgLight}"
                            TextColor="{StaticResource GoldLight}"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            BorderWidth="1"
                            BorderColor="{StaticResource GoldDark}"
                            IsEnabled="{Binding IsGameOver, Converter={StaticResource InvertedBoolConverter}}"/>
                </Grid>

                <!-- Distance Display -->
                <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource MysticPurple}" CornerRadius="10" Padding="10" HasShadow="False">
                    <Label Text="{Binding DistanceText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource MysticPurple}"/>
                </Frame>

                <!-- Game Over Section -->
                <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource Gold}" CornerRadius="10" Padding="15" HasShadow="False" IsVisible="{Binding IsGameOver}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding GameOverMessage}"
                               FontSize="22"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gold}"/>
                        <Button Text="{Binding Source={x:Static services:LocalizationManager.Instance}, Path=ReturnToMenuButtonText}"
                                Command="{Binding ReturnToMenuCommand}"
                                Style="{StaticResource GoldBorderButton}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Battle Log -->
                <Frame BackgroundColor="{StaticResource CardBg}" BorderColor="{StaticResource SteelBlue}" CornerRadius="10" Padding="10" HasShadow="False" HeightRequest="150">
                    <CollectionView ItemsSource="{Binding BattleLog}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" FontSize="12" TextColor="{StaticResource GoldLight}"/>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>